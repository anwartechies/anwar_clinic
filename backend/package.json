{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Anwar Clinic backend — Express + PostgreSQL + Sequelize with dynamic RBAC",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "db:seed": "ts-node src/config/seed.ts",
    "db:seed:platform-admin": "ts-node src/config/seedPlatformAdmin.ts",
    "db:seed:services": "ts-node src/config/seedServices.ts",
    "db:reset:inventory": "node src/modules/inventory/seed/reset.js",
    "db:seed:inventory": "node src/modules/inventory/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
