PORT=5050
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anwar_clinic
JWT_SECRET=anwar-clinic-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Primary frontend origin, used for CORS.
FRONTEND_URL=http://localhost:3100
# Additional allowed origins, comma-separated (landing page, ecommerce, ...).
FRONTEND_URLS=http://localhost:3200,http://localhost:3300

# Absolute base URL of this API — locally-stored upload URLs are built from it.
# Must be the public hostname in production, not localhost.
PUBLIC_URL=http://localhost:5050

# File storage: "local" (disk, default) or "s3".
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760

# --- S3: set STORAGE_DRIVER=s3 and fill these in. No code changes needed. ---
S3_BUCKET=
S3_REGION=
# Leave BOTH blank when running on EC2 with an instance role attached — the AWS
# SDK picks up credentials automatically, which is safer than storing keys.
# Only set these when running outside AWS.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder inside the bucket. Production uses "media" because the bucket's
# public-read policy is scoped to media/* — objects outside it return 403.
S3_KEY_PREFIX=
# Optional CloudFront / custom domain serving the bucket.
S3_PUBLIC_BASE_URL=

# --- Google reviews (Places API New). Leave blank to hide the reviews section. ---
# Key should be restricted to "Places API (New)" and to the server's IP.
GOOGLE_PLACES_API_KEY=
# Place ID of the Google Business Profile, e.g. ChIJ...
GOOGLE_PLACE_ID=
# ...or leave GOOGLE_PLACE_ID blank and give the listing's CID (from its Maps share
# link) plus a query that finds it; the Place ID is looked up by exact CID match.
GOOGLE_PLACE_CID=
GOOGLE_PLACE_QUERY=
GOOGLE_REVIEWS_CACHE_SECONDS=3600

# Folder for PRIVATE files (job-applicant CVs). Must be outside the publicly
# readable prefix (the bucket only grants public read on media/*).
S3_PRIVATE_PREFIX=private

# Rhinon Tech platform admin (a second Super Admin), added by `npm run db:seed`
# or `npm run db:seed:platform-admin`. Leave the password blank to have a strong
# one generated and printed once. Never commit a real password.
PLATFORM_ADMIN_EMAIL=prabhat@rhinon.tech
PLATFORM_ADMIN_PASSWORD=

# Settings → Deploy is available ONLY to prabhat@rhinon.tech (fixed in
# src/config/platform.ts, not configurable here).

# --- Deploy from the admin panel (Settings → Deploy) ---
# Off unless set to true on the server. The server needs a git checkout of this repo.
DEPLOY_ENABLED=false
DEPLOY_PROD_REPO=/home/ubuntu/anwar_clinic
DEPLOY_PROD_BRANCH=main
DEPLOY_PROD_PROC=anwar-clinic-api
# DEPLOY_LOG_DIR=/home/ubuntu/deploy-logs
